# ==========================================
# GITIGNORE CHUẨN CHO DỰ ÁN HUMAN RESOURCES
# ==========================================

# 1. Thư viện Dependencies (Bắt buộc bỏ qua)
node_modules/
**/node_modules/

# 2. Thư mục Build / Biên dịch
dist/
**/dist/
build/
**/build/

# 3. Biến môi trường bảo mật (Chỉ giữ lại file mẫu .env.example)
.env
**/.env
!.env.example
!**/.env.example

# 4. Dữ liệu Docker / Database volumes cục bộ
mysql_data/
n8n_data/

# 5. Nhật ký Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. File IDE & Hệ điều hành
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# 7. File tạm
tmp/
**/tmp/
.temp/

# 8. Tệp tin tải lên của người dùng (CV, tài liệu)
uploads/
**/uploads/*
!**/uploads/.gitkeep

# CV riêng tư của phân hệ ATS
.ats-private/
**/.ats-private/

# Sao lưu cơ sở dữ liệu
backend/backups/*.sql.gz
!backend/backups/.gitkeep
