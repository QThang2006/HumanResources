PORT=3001
NODE_ENV=development

# MySQL Database Configuration (3307 nếu chạy qua Docker, 3306 nếu chạy trực tiếp)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_DATABASE=hr_enterprise_db

# JWT Authentication
JWT_SECRET=super_secret_hr_ai_jwt_key_2026_change_in_production
JWT_EXPIRATION=7d

# Google Gemini AI API (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# n8n Automation Engine Webhooks
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_AI_ENABLED=false
N8N_AI_KEY=replace-with-a-long-random-key
# Khóa riêng cho các API định kỳ do n8n gọi. Hãy thay bằng chuỗi dài, ngẫu nhiên.
N8N_AUTOMATION_SECRET=change_this_to_a_long_random_secret

# Mail Server Configuration (SMTP Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_16_digits
SMTP_FROM="HR Tech Ecosystem <noreply@company.com>"

# Notification & TV2 Recruitment
MAIL_FROM=your_email@gmail.com
HR_EMAIL=your_email@gmail.com
TELEGRAM_CHAT_ID=8928574834
ATS_UPLOAD_DIR=uploads/cvs
PUBLIC_WEB_BASE_URL=http://localhost:5173
RECRUITMENT_CALLBACK_BASE_URL=http://localhost:3001/api
N8N_INTAKE_KEY=
GOOGLE_FORM_SYNC_URL=
GOOGLE_FORM_SYNC_TOKEN=
