PORT=3001
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_DATABASE=hr_enterprise_db

# JWT Authentication
JWT_SECRET=super_secret_hr_ai_jwt_key_2026_change_in_production
JWT_EXPIRATION=7d

# Google Gemini AI API (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Đổi tên model tại biến GEMINI_MODEL này là toàn bộ hệ thống sẽ tự động dùng chung!

# n8n Automation Engine Webhooks
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_AI_ENABLED=false
N8N_AI_KEY=replace-with-a-long-random-key
# Khóa riêng cho các API định kỳ do n8n gọi. Hãy thay bằng chuỗi dài, ngẫu nhiên.
N8N_AUTOMATION_SECRET=change_this_to_a_long_random_secret
# API base reachable from the TV2 readback workflow (same base configured in its guard).
# Leave unset for the legacy workflow; use interview-schedule-readback.json when enabled.
# RECRUITMENT_CALLBACK_BASE_URL=http://localhost:3001/api

# Mail Server Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="HR Tech Ecosystem <noreply@company.com>"

# TV2: three separate n8n workflows. Set real sender/HR addresses before publishing.
# MAIL_FROM must be a plain email address allowed by the SMTP credential in n8n.
MAIL_FROM=
HR_EMAIL=
PUBLIC_WEB_BASE_URL=http://localhost:5173
# Enable this with interview-schedule-readback.json (disable the old interview workflow first).
RECRUITMENT_CALLBACK_BASE_URL=http://localhost:3001/api
# Random secret >=32 characters; use n8n Header Auth: x-intake-key.
# scripts/import-tv2-local.ps1 creates and imports this automatically for local use.
N8N_INTAKE_KEY=
# Apps Script endpoint and shared token, used by scripts/prepare-tv2-local.cjs.
GOOGLE_FORM_SYNC_URL=
GOOGLE_FORM_SYNC_TOKEN=
