{
  "name": "hr-multi-agent-backend",
  "version": "1.0.0",
  "description": "Enterprise HR Multi-Agent Backend with NestJS, MySQL and Gemini AI",
  "author": "HR Tech Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "pretest": "nest build",
    "test": "node --test test/health.test.cjs test/users-role-boundary.test.cjs test/department-manager.test.cjs test/documents.test.cjs test/gemini-timeout.test.cjs test/training-due-date.test.cjs test/job-headcount-deadline.test.cjs",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed:users": "node scripts/seed_users.js",
    "seed:knowledge": "node scripts/seed_knowledge_base.js",
    "seed:recruitment": "node dist/seeds/recruitment-demo.cli.js",
    "seed:tv2-three-cv": "node dist/seeds/tv2-three-cv-demo.cli.js",
    "seed:all": "node scripts/seed_users.js && node scripts/seed_knowledge_base.js && node dist/seeds/recruitment-demo.cli.js",
    "reset:tv3": "node scripts/reset_demo_tv3.js",
    "demo:recruitment": "node test/recruitment-demo.cjs",
    "test:recruitment-seed": "node --test test/recruitment-demo-seed.test.cjs",
    "test:training-reminder": "node --test test/training-reminder.test.cjs",
    "test:training-catalog": "node --test test/training-catalog.test.cjs",
    "migrate:training-history": "node scripts/migrate-tv4-training-history.cjs",
    "test:training-ai": "node --test test/training-ai.test.cjs test/gemini-timeout.test.cjs",
    "test:tv4-automation": "node --test test/training-reminder.test.cjs test/tv4-automation-workflows.test.cjs test/tv4-security.test.cjs",
    "test:review-calendar": "node --test test/review-calendar.test.cjs",
    "test:review-calendar-http": "node --test test/review-calendar-http.test.cjs",
    "test:tv4-workflows": "node --test test/training-reminder.test.cjs test/tv4-automation-workflows.test.cjs test/tv4-workflow-upgrade.test.cjs test/manual-workflow-runs.test.cjs",
    "test:documents": "node --test test/documents.test.cjs",
    "test:website-ack": "node --test test/website-acknowledgement.test.cjs ../scripts/test-website-acknowledgement-workflow.cjs",
    "test:website-ack:http": "node --test test/website-acknowledgement-http.test.cjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.4",
    "oxlint": "^1.94.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
