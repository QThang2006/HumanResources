      "typeVersion": 2,
      "position": [
        1560,
        160
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst p = $json.data;\nconst esc = s => String(s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nreturn { json: { ...p, subject: 'Xác nhận đã nhận hồ sơ ứng tuyển', html: '<p>Chào ' + esc(p.candidateName) + ',</p><p>Phòng Nhân sự đã nhận CV của bạn. Mã hồ sơ: <b>' + p.applicationId + '</b>.</p><p>Chúng tôi sẽ liên hệ sau khi xem xét hồ sơ. Cảm ơn bạn đã ứng tuyển!</p>' } };\n"
      }
