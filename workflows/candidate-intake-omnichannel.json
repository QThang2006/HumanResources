  "nodes": [
    {
      "id": "hrTv2IntakeV2-1",
      "name": "01. Theo dõi CV mới trong Gmail tuyển dụng",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [
        0,
        120
      ],
      "parameters": {
        "downloadAttachments": true,
        "dataPropertyAttachmentsPrefixName": "attachment_",
        "options": {
          "customEmailConfig": "[\"UNSEEN\"]"
        }
      }
    },
    {
      "id": "hrTv2IntakeV2-2",
      "name": "02. Chuẩn hóa hồ sơ nhận qua Gmail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        120
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst m = $json;\nconst sender = m.from?.value?.[0];\nconst job = String(m.subject || '').match(/\\bJOB-(\\d+)\\b/i);\nconst files = Object.values($input.item.binary || {}).filter(b => ['application/pdf','image/png','image/jpeg','image/webp'].includes(b.mimeType) || /\\.(pdf|png|jpe?g|webp)$/i.test(b.fileName || ''));\nif (!job || !sender?.address || !m.id || files.length !== 1) throw Error('Email cần tiêu đề JOB-<id>, địa chỉ người gửi và đúng 1 CV PDF hoặc ảnh PNG/JPG/WEBP.');\nreturn { json: { channel: 'GMAIL', sourceId: m.id, jobId: Number(job[1]), candidateName: sender.name || sender.address.split('@')[0], candidateEmail: sender.address, candidatePhone: String(m.text || '').match(/(?:Phone|Điện thoại)\\s*:\\s*([+\\d ()-]{7,20})/i)?.[1]?.trim() || '' }, binary: { cv: files[0] } };\n"
      }
    },
    {
      "id": "hrTv2IntakeV2-3",
      "name": "03. Phát hiện câu trả lời Google Form mới",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [
        0,
        500
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "14QSDBEyQGC08wyLE33G7PhMRyPdskj1Iy1vu7YzGyH8"
        },
        "sheetName": {
          "__rl": true,
          "mode": "id",
          "value": "2005238133"
        },
        "event": "rowAdded",
        "options": {}
      }
    },
    {
      "id": "hrTv2IntakeV2-4",
      "name": "04. Chuẩn hóa hồ sơ và mã vị trí từ Form",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        500
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst r = $json;\n// The public form uses Vietnamese labels; keep the internal payload stable for ATS.\nconst value = (...keys) => keys.map(key => r[key]).find(item => item !== undefined && item !== null);\nconst raw = String(value('cvFileId', 'Tải lên CV (PDF/PNG/JPG/WEBP)', 'Tải lên CV (định dạng PDF)', 'Tải lên CV') || '').trim();\nconst id = /^[\\w-]{15,}$/.test(raw) ? raw : raw.match(/^https:\\/\\/drive\\.google\\.com\\/(?:file\\/d\\/|open\\?id=)([\\w-]{15,})/)?.[1];\nconst source = r.sourceId || ((r.Timestamp || r['Dấu thời gian']) ? String(r.Timestamp || r['Dấu thời gian']) + ':' + id : '');\nconst rawJob = String(value('jobId', 'Mã vị trí ứng tuyển') || '').trim();\nconst jobId = Number(rawJob.match(/^\\s*(?:JOB-)?(\\d+)\\s*(?:[-–—]|$)/i)?.[1] || rawJob);\nif (!id || !source) throw Error('Sheet cần Timestamp hoặc sourceId duy nhất, cùng cvFileId là file Drive hoặc URL Drive hợp lệ.');\nif (!Number.isSafeInteger(jobId) || jobId < 1) throw Error('Hãy chọn một vị trí tuyển dụng hợp lệ.');\nreturn { json: { channel: 'GOOGLE_FORM', sourceId: String(source), fileId: id, jobId, candidateName: String(value('candidateName', 'Họ và tên ứng viên') || '').trim(), candidateEmail: String(value('candidateEmail', 'Địa chỉ email') || '').trim(), candidatePhone: String(value('candidatePhone', 'Số điện thoại') || '').trim() } };\n"
      }
    },
    {
      "id": "hrTv2IntakeV2-5",
      "name": "05. Tải CV từ Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        520,
        500
      ],
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.fileId }}"
        },
        "options": {
          "binaryPropertyName": "cv"
        }
      }
    },
    {
      "id": "hrTv2IntakeV2-6",
      "name": "06. Kiểm tra thông tin ứng viên và tệp CV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst p = $json, cv = $input.item.binary?.cv;\nif (!Number.isSafeInteger(p.jobId) || p.jobId < 1 || !p.candidateName || p.candidateName.length > 150 || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(p.candidateEmail) || !cv || !/\\.(pdf|png|jpe?g|webp)$/i.test(cv.fileName || '')) throw Error('Thiếu thông tin ứng viên hoặc CV phải là PDF hoặc ảnh PNG/JPG/WEBP.');\nreturn { json: p, binary: { cv } };\n"
      }
    },
