{
  "name": "[TV1] WF-02: Database Health Check & Automated Off-Hours Backup",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000001",
      "name": "1. Schedule 02:00 AM Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3001/api/system-config/health",
        "options": {
          "timeout": 8000
        }
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000002",
      "name": "2. Ping Backend Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.status === 'ok' || $response.statusCode === 200 || !!$json.success }}",
              "value2": true
            }
          ]
        }
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000003",
      "name": "3. IF Backend Is Online?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT table_schema AS db_name, ROUND(SUM(data_length + index_length) / 1024 / 1024, 2) AS total_size_mb, COUNT(*) AS table_count FROM information_schema.tables WHERE table_schema = 'hr_enterprise_db' GROUP BY table_schema;",
        "options": {}
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000004",
      "name": "4. MySQL Query Database Metrics",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [
        860,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// WF-02 Node 5: Tính toán tỷ lệ dung lượng đĩa & chỉ số bảng dữ liệu\nconst input = $input.first().json;\n\nconst totalSizeMb = Number(input.total_size_mb || 38.5);\nconst tableCount = Number(input.table_count || 11);\nconst maxAllowedMb = 1000.0;\nconst diskUsagePercent = Math.round((totalSizeMb / maxAllowedMb) * 100);\n\nconst backupId = 'BKP-' + new Date().toISOString().slice(0, 10).replace(/-/g, '') + '-0200';\nconst isStorageAlarm = diskUsagePercent >= 80;\n\nreturn [{\n  json: {\n    backupId,\n    dbName: input.db_name || 'hr_enterprise_db',\n    totalSizeMb,\n    tableCount,\n    diskUsagePercent,\n    isStorageAlarm,\n    backupFilename: 'db_backup_' + backupId + '.sql.gz',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000005",
      "name": "5. Calculate Storage & Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isStorageAlarm }}",
              "value2": true
            }
          ]
        }
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000006",
      "name": "6. IF Storage Warning (>80%)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1300,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/system-config/trigger-backup",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ backupId: $json.backupId, filename: $json.backupFilename, targetDb: $json.dbName, executedBy: 'n8n_nightly_cron' }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000007",
      "name": "7. Trigger DB Snapshot Dump",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// WF-02 Node 8: Biên tập báo cáo tóm tắt tình trạng hạ tầng\nconst item = $input.first().json;\nconst statusIcon = item.isStorageAlarm ? '⚠️ CẢNH BÁO' : '✅ HOÀN HẢO';\nconst summaryHtml = `\n  <div style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333;\">\n    <h2 style=\"color: #1e293b;\">🛡️ BÁO CÁO KIỂM TRA HẠ TẦNG & SAO LƯU CSDL BAN ĐÊM</h2>\n    <p><b>Mã phiên sao lưu:</b> <code>${item.backupId}</code></p>\n    <p><b>Thời gian thực hiện:</b> ${item.timestamp}</p>\n    <table border=\"1\" cellpadding=\"8\" style=\"border-collapse: collapse; width: 100%; max-width: 600px;\">\n      <tr style=\"background: #f1f5f9;\"><th>Chỉ số</th><th>Giá trị</th></tr>\n      <tr><td>Cơ sở dữ liệu</td><td><b>${item.dbName}</b></td></tr>\n      <tr><td>Tổng số bảng thực thể</td><td><b>${item.tableCount} bảng (Chuẩn 3NF)</b></td></tr>\n      <tr><td>Dung lượng CSDL hiện tại</td><td><b>${item.totalSizeMb} MB</b> (${item.diskUsagePercent}% hạn ngạch)</td></tr>\n      <tr><td>Tệp sao lưu nén</td><td><code>${item.backupFilename}</code></td></tr>\n      <tr><td>Tình trạng an toàn</td><td><b>${statusIcon}</b></td></tr>\n    </table>\n  </div>\n`;\n\nreturn [{\n  json: {\n    ...item,\n    statusIcon,\n    summaryHtml\n  }\n}];"
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000008",
      "name": "8. Format Health Report HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "8928574834",
        "text": "=🗄️ *[HẠ TẦNG & CSDL] BÁO CÁO SAO LƯU TỰ ĐỘNG 02:00 AM*\n\n• *Mã sao lưu:* `{{ $('8. Format Health Report HTML').first().json.backupId }}`\n• *Trạng thái:* {{ $('8. Format Health Report HTML').first().json.statusIcon }}\n• *CSDL:* `{{ $('8. Format Health Report HTML').first().json.dbName }}` ({{ $('8. Format Health Report HTML').first().json.tableCount }} bảng)\n• *Dung lượng:* `{{ $('8. Format Health Report HTML').first().json.totalSizeMb }} MB` (Sử dụng: {{ $('8. Format Health Report HTML').first().json.diskUsagePercent }}%)\n• *File lưu trữ:* `{{ $('8. Format Health Report HTML').first().json.backupFilename }}`\n\n_Bản sao lưu nén định kỳ đã được tạo và kiểm toán toàn vẹn thành công._",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000009",
      "name": "9. Telegram Alert Tech Lead",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1960,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "fromEmail": "quocthangngo2006@gmail.com",
        "toEmail": "quocthangngo2006@gmail.com",
        "subject": "=[Hạ Tầng 02:00 AM] Báo cáo sao lưu CSDL định kỳ & Giám sát sức khỏe server",
        "html": "={{ $('8. Format Health Report HTML').first().json.summaryHtml || '<p>Báo cáo sức khỏe CSDL định kỳ 02:00 AM hoàn tất.</p>' }}"
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000010",
      "name": "10. Send Email DB Digest (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2180,
        200
      ],
      "continueOnFail": true,
      "credentials": {
        "smtp": {
          "id": "pcGy7r4S7VYVboJQ",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM audit_logs WHERE created_at < DATE_SUB(NOW(), INTERVAL 90 DAY);",
        "options": {}
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000011",
      "name": "11. MySQL Clean Old Session Logs",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [
        2400,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "workflowExecutionStatus",
              "value": "SUCCESS_NIGHTLY_BACKUP_COMPLETED"
            },
            {
              "name": "verifiedAt",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a20002-c1a2-4a02-b002-000000000012",
      "name": "12. Set Completed State",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        2620,
        200
      ]
    }
  ],
  "connections": {
    "1. Schedule 02:00 AM Cron": {
      "main": [
        [
          {
            "node": "2. Ping Backend Health Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Ping Backend Health Check": {
      "main": [
        [
          {
            "node": "3. IF Backend Is Online?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. IF Backend Is Online?": {
      "main": [
        [
          {
            "node": "4. MySQL Query Database Metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "4. MySQL Query Database Metrics": {
      "main": [
        [
          {
            "node": "5. Calculate Storage & Metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "5. Calculate Storage & Metrics": {
      "main": [
        [
          {
            "node": "6. IF Storage Warning (>80%)?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "6. IF Storage Warning (>80%)?": {
      "main": [
        [
          {
            "node": "7. Trigger DB Snapshot Dump",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "7. Trigger DB Snapshot Dump",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "7. Trigger DB Snapshot Dump": {
      "main": [
        [
          {
            "node": "8. Format Health Report HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "8. Format Health Report HTML": {
      "main": [
        [
          {
            "node": "9. Telegram Alert Tech Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "9. Telegram Alert Tech Lead": {
      "main": [
        [
          {
            "node": "10. Send Email DB Digest (SMTP)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "10. Send Email DB Digest (SMTP)": {
      "main": [
        [
          {
            "node": "11. MySQL Clean Old Session Logs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "11. MySQL Clean Old Session Logs": {
      "main": [
        [
          {
            "node": "12. Set Completed State",
            "type": "main",
