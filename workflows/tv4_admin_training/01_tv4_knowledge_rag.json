    {
      "parameters": {
        "jsCode": "const answerData = $json.data ?? $json;\nconst searchOutput = $('Tìm nội dung liên quan').item.json;\nconst results = searchOutput.data ?? searchOutput;\nreturn [{\n  json: {\n    success: true,\n    workflow: 'TV4 - 01 Trả lời Kho tri thức có dẫn nguồn',\n    answer: String(answerData.answer ?? ''),\n    sources: Array.isArray(answerData.sources) ? answerData.sources : [],\n    results: Array.isArray(results) ? results.map(item => ({\n      chunkId: item.chunkId,\n      documentId: item.documentId,\n      documentTitle: item.documentTitle,\n      chunkIndex: item.chunkIndex,\n      content: item.content,\n      similarity: item.similarity,\n    })) : [],\n    suggestedFollowUpQuestions: Array.isArray(answerData.suggestedFollowUpQuestions) ? answerData.suggestedFollowUpQuestions : [],\n    requiresHrIntervention: Boolean(answerData.requiresHrIntervention),\n    aiGenerated: Boolean(answerData.aiGenerated),\n  },\n}];"
      },
