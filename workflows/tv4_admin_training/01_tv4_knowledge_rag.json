    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst headers = $json.headers ?? {};\nconst query = String(body.query ?? '').trim();\nconst requestedTopK = Number(body.topK ?? 4);\nconst topK = Math.min(Math.max(Number.isFinite(requestedTopK) ? requestedTopK : 4, 1), 5);\nconst authorization = headers.authorization ?? headers.Authorization ?? body.authorization ?? '';\nif (!query) throw new Error('Vui lòng nhập câu hỏi.');\nif (!authorization) throw new Error('Thiếu thông tin xác thực người dùng.');\nreturn [{ json: { query, topK, authorization } }];"
      },
