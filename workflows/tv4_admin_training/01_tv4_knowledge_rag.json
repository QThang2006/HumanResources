        "jsCode": "const body = $json.body ?? $json;\nconst headers = $json.headers ?? {};\nconst query = String(body.query ?? '').trim();\nconst requestedTopK = Number(body.topK ?? 3);\nconst topK = Math.min(Math.max(Number.isFinite(requestedTopK) ? requestedTopK : 3, 1), 10);\nconst authorization = headers.authorization ?? headers.Authorization ?? body.authorization ?? '';\nif (!query) throw new Error('query is required');\nif (!authorization) throw new Error('Authorization header is required');\nreturn [{ json: { query, topK, authorization } }];"
      },
